# Use the Day 6 PostgreSQL/pgvector database. Default compose port is 55433.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DAY6_PROJECT_DIR=./day6_reference
DAY6_STRATEGY=C
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Real agent model. For OpenRouter, set OPENROUTER_API_KEY and an OpenRouter model slug.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
